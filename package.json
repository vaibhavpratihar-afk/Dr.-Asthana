{
  "name": "auto-dev-agent",
  "version": "3.0.0",
  "description": "Slim Claude wrapper: runs Claude Code in the cms-ai workspace on labeled JIRA tickets, on a schedule",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "auto-dev-agent": "src/index.js"
  },
  "scripts": {
    "start": "node --use-system-ca src/index.js",
    "ticket": "node --use-system-ca src/index.js"
  },
  "packageManager": "pnpm@10.29.3",
  "dependencies": {
    "@slack/web-api": "^7.13.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "jira",
    "automation",
    "claude",
    "claude-code",
    "cms-ai",
    "ai-agent"
  ],
  "author": "",
  "license": "MIT"
}
